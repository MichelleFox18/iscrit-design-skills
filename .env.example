# Runtime login is NOT the database owner. Setup creates design_app.
POSTGRES_PASSWORD=local-bootstrap-only
DATABASE_URL=postgresql://design_app:local-development-only@127.0.0.1:54329/design_growth
# Used by setup only, never by Next.js runtime.
MIGRATION_DATABASE_URL=postgresql://postgres:local-bootstrap-only@127.0.0.1:54329/design_growth
APP_DATABASE_PASSWORD=local-development-only
# Local synthetic accounts only; omit on production.
SEED_DEMO=true
DEMO_PASSWORD=Design-Demo-2026!
# Required canonical HTTPS origin for production (no trailing slash).
# APP_ORIGIN=https://design.example.org
# Hosting-only initial account; enter real values securely in hosting settings.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
